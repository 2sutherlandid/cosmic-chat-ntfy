# Example environment variables for cosmic-chat-ntfy

# Server
PORT=3000
SESSION_SECRET=replace_with_a_random_string
DB_PATH=./data/cosmic.sqlite

# ntfy
NTFY_HOST=https://ntfy.com
NTFY_TOPIC_PREFIX=cosmic
NTFY_PROXY_ENABLED=true
# If using proxy publish to ntfy with basic auth (optional)
NTFY_BASIC_USER=
NTFY_BASIC_PASS=
